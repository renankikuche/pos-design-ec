---
import type { ProjectListItem } from "../sanity/queries";
import ViewToggle from "./ViewToggle.astro";

interface Props {
  projects: ProjectListItem[];
}

const { projects } = Astro.props;
---

<style>
  .project-list {
    transition: opacity 0.2s ease;
  }

  .project-list[data-view="list"] .project-list__item {
    padding: var(--space-base);
    border-bottom: var(--border-width) solid var(--border-color);
  }

  .project-list[data-view="list"] .project-list__link {
    font-size: var(--font-size-display);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .project-list[data-view="list"] .project-list__image {
    display: none;
  }

  .project-list[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-base);
  }

  .project-list[data-view="grid"] .project-list__link {
    display: block;
  }

  .project-list[data-view="grid"] .project-list__image {
    display: block;
  }
</style>

<ul class="project-list" data-view="list">
  {
    projects.map((project) => (
      <li class="project-list__item">
        <a
          class="project-list__link"
          href={`/projetos/${project.slug.current}`}
        >
          {project.featuredImage && (
            <img
              class="project-list__image"
              src={`${project.featuredImage.asset.url}?w=800`}
              width={project.featuredImage.asset.metadata.dimensions.width}
              height={project.featuredImage.asset.metadata.dimensions.height}
              alt={project.featuredImage.alt ?? project.name}
            />
          )}
          <span class="project-list__name">{project.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<script is:inline>
  (function () {
    try {
      var savedView = localStorage.getItem("project-list-view");
      if (savedView === "grid") {
        document.querySelector(".project-list").dataset.view = savedView;
      }
    } catch (e) {
      /* localStorage unavailable (private mode, etc.) */
    }
  })();
</script>

<ViewToggle />
