---
import type { ProjectListItem } from "../sanity/queries";
import ViewToggle from "./ViewToggle.astro";

interface Props {
  projects: ProjectListItem[];
}

const { projects } = Astro.props;
---

<style>
  .project-list {
    transition: opacity 0.2s ease;
  }

  .project-list[data-view="list"] .project-list__item {
    padding: var(--space-base);
    border-bottom: var(--border-width) solid var(--border-color);
  }

  .project-list[data-view="list"] .project-list__link {
    font-size: var(--font-size-display);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .project-list[data-view="list"] .project-list__image {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 33.33vw;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-list[data-view="list"] .project-list__item--active .project-list__image {
    opacity: 1;
  }

  .project-list[data-view="list"] .project-list__item--active .project-list__name {
    color: transparent;
    -webkit-text-stroke: var(--border-width) var(--border-color);
  }

  .project-list[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-base);
  }

  .project-list[data-view="grid"] .project-list__link {
    display: block;
  }

  .project-list[data-view="grid"] .project-list__image {
    display: block;
  }
</style>

<ul class="project-list" data-view="list">
  {
    projects.map((project) => (
      <li class="project-list__item">
        <a
          class="project-list__link"
          href={`/projetos/${project.slug.current}`}
        >
          {project.featuredImage && (
            <img
              class="project-list__image"
              src={`${project.featuredImage.asset.url}?w=800`}
              width={project.featuredImage.asset.metadata.dimensions.width}
              height={project.featuredImage.asset.metadata.dimensions.height}
              alt={project.featuredImage.alt ?? project.name}
            />
          )}
          <span class="project-list__name">{project.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<script is:inline>
  (function () {
    try {
      var savedView = localStorage.getItem("project-list-view");
      if (savedView === "grid") {
        document.querySelector(".project-list").dataset.view = savedView;
      }
    } catch (e) {
      /* localStorage unavailable (private mode, etc.) */
    }
  })();
</script>

<script>
  const ACTIVE_CLASS = "project-list__item--active";

  const list = document.querySelector<HTMLElement>(".project-list");

  let mouseX = -1;
  let mouseY = -1;
  let activeItem: HTMLElement | null = null;
  let ticking = false;

  function setActive(next: HTMLElement | null) {
    if (next === activeItem) return;
    activeItem?.classList.remove(ACTIVE_CLASS);
    next?.classList.add(ACTIVE_CLASS);
    activeItem = next;
  }

  function updateActiveItem() {
    ticking = false;

    if (!list || list.dataset.view !== "list" || mouseX < 0 || mouseY < 0) {
      setActive(null);
      return;
    }

    const el = document.elementFromPoint(mouseX, mouseY);
    const item = el?.closest<HTMLElement>(".project-list__item") ?? null;

    setActive(list.contains(item) ? item : null);
  }

  function requestUpdate() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActiveItem);
  }

  document.addEventListener("mousemove", (event) => {
    mouseX = event.clientX;
    mouseY = event.clientY;
    requestUpdate();
  });

  window.addEventListener("scroll", requestUpdate, { passive: true });

  document.addEventListener("mouseleave", () => {
    mouseX = -1;
    mouseY = -1;
    requestUpdate();
  });
</script>

<ViewToggle />
